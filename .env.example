# EcoMind AI Environment Configuration
# Copy this file to .env and configure your variables.
# When IBM watsonx credentials are absent, EcoMind AI operates seamlessly in DEMO / LOCAL MODE.

# IBM watsonx.ai & Granite Configuration
IBM_WATSONX_URL=https://us-south.ml.cloud.ibm.com
IBM_WATSONX_API_KEY=your_ibm_watsonx_api_key_here
IBM_WATSONX_PROJECT_ID=your_ibm_watsonx_project_id_here
IBM_GRANITE_MODEL=ibm/granite-13b-chat-v2

# Application Settings
DATASET_PATH=data/energy_data.csv
PORT=8080
